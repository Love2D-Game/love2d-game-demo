  <object id="158" name="QiPool" x="32" y="32" width="128" height="96">
   <properties>
    <property name="message" value="The pool radiates immense amounts of spiritual energy, but something prevents you from using it to cultivate."/>
    <property name="prompt" value="E: Examine Qi Pool"/>
   </properties>
  </object>
  <object id="159" name="UrHouse" x="128" y="672" width="160" height="128">
   <properties>
    <property name="message" value="This is your house, apparently! You took a look inside, and see... that you are dirt poor. There's nothing inside besides a bed."/>
    <property name="prompt" value="E: Enter the house."/>
   </properties>
  </object>
  <object id="160" name="NotUrHouse2" x="288" y="256" width="160" height="128">
   <properties>
    <property name="message" value="&quot;RAAAHHHHH HOW DARE YOU ENTER MY HOME YOU INTRUDER!!! LEAVE INSTANTLY OR ELSE!!!&quot; The person inside brandishes a knife. You flail around in panic, and leave the house at once."/>
    <property name="prompt" value="E: Enter the house."/>
   </properties>
  </object>
  <object id="161" name="ChiefHouse" x="800" y="160" width="192" height="160">
   <properties>
    <property name="message" value="... Are you seeking death? You dare enter the humble home of the village chief? Uninvited? Wow, what kind of person are you?"/>
    <property name="prompt" value="E: Enter the house."/>
   </properties>
  </object>
  <object id="162" name="NotUrHouse1" x="1056" y="448" width="160" height="128">
   <properties>
    <property name="message" value="&quot;AHHH A THIEF!!!&quot; The person inside shrieks, smacks the hell out of you with their rusty pot, and drop kicks you out of the house."/>
    <property name="prompt" value="E: Enter the house."/>
   </properties>
  </object>
  <object id="163" name="GetLost" x="704" y="1408" width="96" height="32">
   <properties>
    <property name="message" value="The village is surrounded by tall, shadowed trees. Outside, it looks dark and creepy. You spot large vultures perched on top of the trees staring at you."/>
    <property name="prompt" value="E: Leave the village to explore into the unknown."/>
   </properties>
  </object>
